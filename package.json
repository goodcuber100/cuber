{
  "name": "stand-clear-nyc-subway",
  "version": "1.0.0",
  "private": true,
  "description": "Stand Clear! A cartoon NYC subway simulator on the real MTA map: MTA Manager tycoon mode and first-person Conductor mode.",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 -o .",
    "data:fetch": "bash tools/fetch-data.sh .data-src",
    "data:build": "node tools/build-data.mjs --gtfs .data-src/gtfs/gtfs_json/subway --stations .data-src/mss/stations.json --land .data-src/lands10m.geo.json --nybb .data-src/nybb",
    "balance": "node tools/sim-test.mjs 6"
  },
  "license": "MIT"
}
